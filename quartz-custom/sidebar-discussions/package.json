{
  "name": "@ksmtang/sidebar-discussions",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "quartz": {
    "name": "sidebar-discussions",
    "displayName": "Sidebar Discussions",
    "category": "component",
    "version": "0.1.0",
    "quartzVersion": ">=5.0.0",
    "defaultOptions": {
      "repo": "MATHhahetaDEATH/blog",
      "limit": 3,
      "maxChars": 50,
      "title": "最近讨论"
    },
    "components": {
      "SidebarDiscussions": {
        "displayName": "Sidebar Discussions",
        "defaultPosition": "left",
        "defaultPriority": 40
      }
    }
  }
}
